# Python caches and build outputs
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Environment variables and credentials
.env
.env.*

# Raw/processed datasets and generated outputs (keep directory placeholders)
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
data/manifests/*.csv
data/manifests/*.parquet
outputs/embeddings/*
!outputs/embeddings/.gitkeep
outputs/metrics/*
!outputs/metrics/.gitkeep
outputs/visual_atlas/*
!outputs/visual_atlas/.gitkeep

# Model weights and large archives
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.zip
*.tar
*.tar.gz
